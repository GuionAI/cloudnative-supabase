.idea
.vscode
*.swp
*.swo
*~

# Kubeconfig might contain secrets
*.kubeconfig

# Environment files with secrets
.env
.env.*
!.env.example

# macOS
.DS_Store

# Coverage
cover.out
coverage.html

# envtest binaries
testbin/

